# Local / Compose development environment.
# Usage: docker compose --env-file .env.dev up --build

# Postgres
POSTGRES_DB=application-tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend
SPRING_PROFILES_ACTIVE=dev-postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/application-tracker
SECURITY_JWT_SECRET_KEY=3cfa76ef14937c1c0ea519f8fc057a80fcd04a7420f8e8bcd0a7567c272e007b
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# Frontend (browser-facing API URL; not the Docker service name)
VITE_API_BASE_URL=http://localhost:8080

# Published ports
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
